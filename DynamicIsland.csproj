<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DynamicIsland</RootNamespace>
    <AssemblyName>DynamicIsland</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <StartupObject>DynamicIsland.Program</StartupObject>
    <NoWarn Condition="'$(Configuration)' == 'Release'">$(NoWarn);CS0649</NoWarn>
    <Version>2.1.1</Version>
    <Product>ZERUNOS</Product>
    <AssemblyTitle>ZERUNOS</AssemblyTitle>
    <Description>ZERUNOS — Dynamic Island for Windows.</Description>
    <Copyright>Copyright (c) 2026, MIT License</Copyright>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DynamicIsland.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\claude-hook.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\icon.ico" />
    <EmbeddedResource Include="Assets\lang\*.json" />
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="DynamicIsland.CHANGELOG.md" />
  </ItemGroup>
</Project>
